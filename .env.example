# ===== Brain Core Settings =====
SECRET_KEY=change-this-to-a-long-random-secret-in-production

# ===== Database (Hostinger or Local) =====
# 1. SQLite (default, zero setup):
# DATABASE_URL is unset → defaults to instance/brain_users.db
# 2. Hostinger MySQL (via hPanel or VPS MySQL):
# DATABASE_URL=mysql+pymysql://u123456789_user:Password123!@127.0.0.1:3306/u123456789_brain
# 3. Hostinger PostgreSQL (via VPS PostgreSQL):
# DATABASE_URL=postgresql://brain_user:Password123!@localhost:5432/brain_db

# ===== JWT Settings =====
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# ===== Brevo Transactional SMTP Email =====
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_master_or_smtp_key
SMTP_FROM_NAME=Brain
SMTP_FROM_EMAIL=ai@obrive.com
APP_BASE_URL=https://brain.obrive.com

# ===== Platform LLM (server-side only) =====
# Every simulation runs on the platform credential below. There is no
# bring-your-own-key flow; users never supply or see an API key.
# OpenAI format, supports Groq, DeepSeek, NVIDIA NIM, OpenAI, etc.
# Multi-key rotation supported: provide comma-separated keys (e.g. key1,key2,key3)
# Requests will round-robin across keys and automatically failover on 429 rate limit.
LLM_API_KEY=your_api_key_or_comma_separated_keys_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=qwen/qwen3.8-27b
# Maximum document characters included in the ontology LLM request
ONTOLOGY_MAX_TEXT_LENGTH=30000

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
# Multi-key automatic failover supported: provide primary & backup keys
ZEP_API_KEY=your_zep_api_key_here
ZEP_BACKUP_API_KEY=your_backup_zep_api_key_here
# Optional: comma-separated list of multiple keys (ZEP_API_KEYS=key1,key2,key3)


# ===== Multi-Provider LLM & Parallel Execution Configuration =====
# Combine multiple high-allowance free providers (Mistral 1B, Gemini, Groq) in parallel!
# Twitter runs on LLM_*, Reddit runs on LLM_BOOST_*, and failover cascades to LLM_BACKUP_*.
LLM_BOOST_API_KEY=your_mistral_api_key_here
LLM_BOOST_BASE_URL=https://api.mistral.ai/v1
LLM_BOOST_MODEL_NAME=open-mistral-nemo

LLM_BACKUP_API_KEY=your_gemini_api_key_here
LLM_BACKUP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BACKUP_MODEL_NAME=gemini-2.0-flash

# ===== Subscription billing (Razorpay, USD) =====
# Create the six plans once with: python backend/scripts/setup_razorpay_plans.py
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=rzp_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret
RAZORPAY_PLAN_ID_STARTER_MONTHLY=plan_xxx
RAZORPAY_PLAN_ID_STARTER_ANNUAL=plan_xxx
RAZORPAY_PLAN_ID_PRO_MONTHLY=plan_xxx
RAZORPAY_PLAN_ID_PRO_ANNUAL=plan_xxx
RAZORPAY_PLAN_ID_PREMIUM_MONTHLY=plan_xxx
RAZORPAY_PLAN_ID_PREMIUM_ANNUAL=plan_xxx

# ===== Admin accounts =====
# Comma-separated emails that receive unlimited runs and uncapped rounds.
ADMIN_EMAILS=ai@obrive.com,admin@obrive.com
ADMIN_PASSWORD=Yashveer@2910

