# ===== ObMind Core Settings =====
SECRET_KEY=change-this-to-a-long-random-secret-in-production

# ===== Database =====
# SQLite (local dev, zero setup):
# DATABASE_URL is unset → defaults to SQLite file at backend/instance/obmind_users.db
# PostgreSQL (production):
DATABASE_URL=postgresql://obmind_user:yourpassword@localhost:5432/obmind_db

# ===== JWT Settings =====
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ===== Email / SMTP =====
# If SMTP_USER and SMTP_PASSWORD are not set, emails are logged to console (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_FROM_NAME=ObMind by Obrive
SMTP_FROM_EMAIL=noreply@yourdomain.com
APP_BASE_URL=https://obfish.obrive.com

# LLM API Configuration (OpenAI format, supports Groq, DeepSeek, NVIDIA NIM, OpenAI, etc.)
# Multi-key rotation supported: provide comma-separated keys (e.g. key1,key2,key3)
# Requests will round-robin across keys and automatically failover on 429 rate limit.
LLM_API_KEY=your_api_key_or_comma_separated_keys_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=qwen/qwen3.8-27b
# Maximum document characters included in the ontology LLM request
ONTOLOGY_MAX_TEXT_LENGTH=30000

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Parallel Dual-LLM Boost Configuration (Optional) =====
# Enables Reddit platform to run on a 2nd provider in parallel with Twitter!
# Also supports comma-separated keys for multi-key rotation and failover.
LLM_BOOST_API_KEY=your_boost_api_key_here
LLM_BOOST_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_BOOST_MODEL_NAME=deepseek-ai/deepseek-v4.1-flash

